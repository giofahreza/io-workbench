[Unit]
Description=io-workbench release deployment GitHub Actions runner
After=network-online.target
Wants=network-online.target

[Service]
User=giofahreza
Group=giofahreza
WorkingDirectory=/home/giofahreza/.local/share/actions-runner/io-workbench-deploy
ExecStart=/home/giofahreza/.local/share/actions-runner/io-workbench-deploy/run.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=5min

[Install]
WantedBy=multi-user.target
