    },
    "/api/git/init": {
      "post": { "tags": ["Git"], "summary": "Initialize a repository" }
    },
    "/api/git/diff": {
      "get": { "tags": ["Git"], "summary": "Read a file diff" }
    },
    "/api/git/file-with-diff": {
      "get": { "tags": ["Git"], "summary": "Read before/current file content for review" }
    },
    "/api/git/initial-commit": {
      "post": { "tags": ["Git"], "summary": "Create an initial commit" }
    },
    "/api/git/commit": {
