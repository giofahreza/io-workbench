    },
    "/api/cli/{provider}/status": {
      "get": { "tags": ["Compatibility"], "summary": "Read provider CLI status" }
    },
    "/api/agent/{path}": {
      "x-any": { "tags": ["Compatibility"], "summary": "Legacy agent compatibility endpoint" }
    },
    "/api/codex/{path}": {
      "x-any": { "tags": ["Compatibility"], "summary": "Provider compatibility endpoint" }
    },
    "/api/cursor/{path}": {
      "x-any": { "tags": ["Compatibility"], "summary": "Provider compatibility endpoint" }
    },
    "/api/gemini/{path}": {
      "x-any": { "tags": ["Compatibility"], "summary": "Provider compatibility endpoint" }
    },
    "/api/plugins/{path}": {
      "x-any": { "tags": ["Compatibility"], "summary": "Plugin compatibility endpoint" }
    },
