    },
    "/api/git/create-branch": {
      "post": { "tags": ["Git"], "summary": "Create a branch" }
    },
    "/api/git/delete-branch": {
      "post": { "tags": ["Git"], "summary": "Delete a branch" }
    },
    "/api/git/commits": {
      "get": { "tags": ["Git"], "summary": "List commits" }
    },
    "/api/git/commit-diff": {
      "get": { "tags": ["Git"], "summary": "Read a commit diff" }
    },
    "/api/git/generate-commit-message": {
      "post": { "tags": ["Git"], "summary": "Generate a commit message" }
    },
    "/api/git/remote-status": {
      "get": { "tags": ["Git"], "summary": "Read remote tracking status" }
    },
    "/api/git/remote": {
      "post": { "tags": ["Git"], "summary": "Set a Git remote" }
    },
    "/api/git/fetch": {
      "post": { "tags": ["Git"], "summary": "Fetch from remote" }
    },
    "/api/git/pull": {
      "post": { "tags": ["Git"], "summary": "Pull from remote" }
    },
    "/api/git/push": {
