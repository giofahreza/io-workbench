{
  "openapi": "3.1.0",
  "info": {
    "title": "io-workbench API",
    "version": "0.1.0",
    "description": "HTTP and WebSocket API exposed by the io-workbench Rust server."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Core" },
    { "name": "Auth" },
    { "name": "Projects" },
    { "name": "Files" },
    { "name": "Sessions" },
    { "name": "Git" },
    { "name": "Database" },
    { "name": "Process" },
    { "name": "Settings" },
    { "name": "Tools" },
    { "name": "Compatibility" }
  ],
  "paths": {
    "/health": {
      "get": { "tags": ["Core"], "summary": "Read server health", "security": [] }
    },
    "/ws": {
      "get": { "tags": ["Core"], "summary": "Open the workspace WebSocket stream" }
    },
    "/api/auth/status": {
      "get": { "tags": ["Auth"], "summary": "Read authentication status", "security": [] }
    },
    "/api/auth/register": {
      "post": { "tags": ["Auth"], "summary": "Create the first local account", "security": [] }
    },
    "/api/auth/login": {
      "post": { "tags": ["Auth"], "summary": "Create an auth token", "security": [] }
    },
    "/api/auth/logout": {
      "post": { "tags": ["Auth"], "summary": "Invalidate the current auth token" }
    },
    "/api/auth/user": {
      "get": { "tags": ["Auth"], "summary": "Read the current user" }
    },
    "/api/projects": {
      "get": { "tags": ["Projects"], "summary": "List indexed projects" }
    },
    "/api/projects/create": {
      "post": { "tags": ["Projects"], "summary": "Add an existing project path" }
    },
    "/api/projects/create-workspace": {
      "post": { "tags": ["Projects"], "summary": "Create or clone a workspace" }
    },
    "/api/projects/clone-progress": {
      "get": { "tags": ["Projects"], "summary": "Stream clone progress events" }
    },
    "/api/projects/{project_name}": {
      "delete": { "tags": ["Projects"], "summary": "Delete a project record" }
    },
    "/api/projects/{project_name}/sessions": {
      "get": { "tags": ["Sessions"], "summary": "List persisted sessions for a project" }
    },
    "/api/projects/{project_name}/sessions/{session_id}/token-usage": {
      "get": { "tags": ["Sessions"], "summary": "Read token usage for a project session" }
    },
    "/api/projects/{project_name}/files": {
      "get": { "tags": ["Files"], "summary": "List files under a project path" },
      "delete": { "tags": ["Files"], "summary": "Delete a project file or directory" }
    },
    "/api/projects/{project_name}/files/content": {
      "get": { "tags": ["Files"], "summary": "Read file content" }
    },
    "/api/projects/{project_name}/file": {
      "put": { "tags": ["Files"], "summary": "Write file content" }
    },
    "/api/projects/{project_name}/files/create": {
      "post": { "tags": ["Files"], "summary": "Create a file or directory" }
    },
    "/api/projects/{project_name}/files/rename": {
      "put": { "tags": ["Files"], "summary": "Rename a file or directory" }
    },
    "/api/projects/{project_name}/files/upload": {
      "post": { "tags": ["Files"], "summary": "Upload one or more files" }
    },
    "/api/projects/{project_name}/upload-images": {
      "post": { "tags": ["Files"], "summary": "Upload chat image attachments" }
    },
    "/api/sessions/{session_id}": {
      "delete": { "tags": ["Sessions"], "summary": "Delete a chat session and its messages" }
    },
    "/api/sessions/{session_id}/messages": {
      "get": { "tags": ["Sessions"], "summary": "Read session messages" }
    },
    "/api/sessions/{session_id}/fork": {
      "post": {
        "tags": ["Sessions"],
        "summary": "Create a non-destructive chat fork before a user prompt",
        "description": "Creates a new inactive session containing only messages strictly before the selected persisted user message. The selected prompt is saved as the destination draft and is not sent automatically. The source session and project files remain unchanged. Reusing requestId for the same source session returns the original fork.",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ForkSessionRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The created or previously created idempotent fork",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ForkSessionResponse" }
              }
            }
          },
          "400": {
            "description": "Invalid message, request identifier, or unsupported exact native-runtime fork",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "404": {
            "description": "Source session or selected message was not found",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          },
          "409": {
            "description": "The source session became active or a Codex native boundary could not be resolved",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiError" }
              }
            }
          }
        }
      }
    },
    "/api/sessions/{session_id}/model": {
      "get": { "tags": ["Sessions"], "summary": "Read a session model override" },
      "put": { "tags": ["Sessions"], "summary": "Update a session model override" }
    },
    "/api/sessions/{session_id}/rename": {
      "put": { "tags": ["Sessions"], "summary": "Rename a session" }
    },
    "/api/search/conversations": {
      "get": { "tags": ["Sessions"], "summary": "Search stored conversations" }
    },
    "/api/git/status": {
